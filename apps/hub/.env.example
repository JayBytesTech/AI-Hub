HUB_PORT=3000
HUB_HOST=0.0.0.0
HUB_DB_PATH=apps/hub/data/hub.db
TERMINAL_CONFIRM_REQUIRED=true

# Optional provider keys/models
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-3-5-sonnet-latest
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Provider runtime reliability
PROVIDER_REQUEST_TIMEOUT_MS=20000
PROVIDER_REQUEST_RETRIES=2
PROVIDER_RETRY_BASE_DELAY_MS=300
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_MS=30000

# Security policy (optional)
# Example: /home/user/projects,/home/user/notes
HUB_WORKSPACE_ALLOWED_ROOTS=
# Example: rm\\s+-rf,shutdown,reboot
TERMINAL_BLOCKLIST_PATTERNS=
