{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-hub/schemas/ws-event.schema.json",
  "title": "WebSocketEvent",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "runId", "content"],
  "properties": {
    "type": {
      "type": "string",
      "const": "chat.stream.delta"
    },
    "runId": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "string"
    }
  }
}

